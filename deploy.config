# Settings shared by deploy.sh (CloudShell) and the GitHub Actions pipeline.
# None of these are secrets, so they're safe to commit.

STACK=pdc-serverless
REGION=us-east-1

# 12-digit ID of the AWS account that hosts the site (the pipeline signs in here)
AWS_ACCOUNT_ID=551742918115

# GitHub repo that's allowed to deploy, as owner/name
GITHUB_REPO=GabrielVestergaard/pdc-serverless

# Custom domain + its ACM certificate (us-east-1). Leave CERT_ARN blank until the cert says "Issued".
DOMAIN=donuts.lincolnlyons.com
CERT_ARN=

# Set to false if the AWS account already has a GitHub OIDC provider
CREATE_OIDC=true

# Optional: email for Lambda error alerts
ALERT_EMAIL=
